# Current Next.js report service. Copy to .env.local for development.
# Use a development-only Private Blob store and Discord application/channel.
# Production REPORTS_SITE_URL must be the HTTPS origin, without a route path.
REPORTS_SITE_URL=http://localhost:3000
REPORTS_SERVICE=club
BLOB_READ_WRITE_TOKEN=

# Club administrator password: at least 8 characters.
FUNDING_ADMIN_USERNAME=admin
FUNDING_ADMIN_TOKEN=
# Separate publish-only credential: at least 32 random characters.
FUNDING_PUBLISHER_TOKEN=

# Shared /personal reports: Discord readers require no administrator approval.
# These credentials are for owner recovery and publisher access, not readers.
PERSONAL_ADMIN_USERNAME=
PERSONAL_ADMIN_TOKEN=
PERSONAL_PUBLISHER_TOKEN=
# Optional dedicated Private Blob token; otherwise uses the shared store.
PERSONAL_BLOB_READ_WRITE_TOKEN=

# Shared Discord OAuth app; both mounts use /reports/auth/callback.
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_SECRET=
# Required in Vercel for personal channel delivery even when club uses worker.
DISCORD_BOT_TOKEN=
# Distinct channels for club and contest/job reports. Configure before publishing.
DISCORD_REPORT_CHANNEL_ID=
PERSONAL_DISCORD_REPORT_CHANNEL_ID=
DISCORD_DM_ENABLED=false

# Club only: direct for Vercel delivery, worker for the Dishost notifier.
# /personal always uses direct delivery and its own channel setting.
DISCORD_DELIVERY_MODE=direct
# Only for worker mode: match Dishost; at least 32 chars, separate from other keys.
DISCORD_WORKER_TOKEN=
